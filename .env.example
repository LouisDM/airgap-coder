# 由 `lc init` 生成。此文件是模板，真实的 .env 含密钥且已 gitignore。
#
# 命名规则：每个上游 <name> 对应两个变量
#   KEY_<NAME>        API Key
#   KEY_<NAME>_BASE   Base URL（到 /v1 为止）
# 名称中的连字符转为下划线，如 upstream "qwen-32b" -> KEY_QWEN_32B

# 网关自身的鉴权凭据，Codex 用它访问 LiteLLM。`lc init` 会随机生成。
LITELLM_MASTER_KEY=sk-lc-change-me
GATEWAY_PORT=4000

# 示例上游
KEY_INTRANET=your-api-key-here
KEY_INTRANET_BASE=http://vllm.your-intranet.local:8000/v1
