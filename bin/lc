#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""lc —— airgap-coder 的配置与运维 CLI。

所有配置通过命令完成，不需要手改 yaml/toml：
    lc init              交互式初始化
    lc add               交互式添加一个模型上游
    lc ls                列出上游
    lc use <name>        切换默认上游
    lc rm <name>         删除上游
    lc up / down / status / logs
    lc test [name]       协议层 5 项测试
    lc e2e [name]        端到端测试（真改代码）
    lc code [args...]    用当前上游启动 Codex
    lc doctor            环境体检
    lc sync              由注册表重新生成 litellm/codex 配置
    lc migrate           把 registry 里遗留的明文 header 值搬进 .env
    lc export            打一个可搬运进内网的自包含离线包

真实密钥只写入 .env（已 gitignore）；registry.json 只存非敏感信息，可以提交：
地址、API Key、自定义 HTTP 头的值都只留变量名，实际值在 .env 里。
"""
from __future__ import print_function

import json
import os
import pathlib
import re
import shutil
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
REGISTRY = ROOT / "registry.json"
ENVFILE = ROOT / ".env"
LITELLM_CFG = ROOT / "litellm" / "config.yaml"
CODEX_DIR = ROOT / "codex"
GW_PORT_DEFAULT = 4000
GW_WAIT_DEFAULT = 45          # `lc up` 等网关就绪的轮数，见 gw_wait_tries()


def project_version():
    """Read the release version from the single source of truth."""
    try:
        return (ROOT / "VERSION").read_text().strip()
    except OSError:
        return "unknown"

C = {"r": "\033[31m", "g": "\033[32m", "y": "\033[33m", "b": "\033[36m",
     "d": "\033[2m", "x": "\033[0m", "B": "\033[1m"}
if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
    C = dict((k, "") for k in C)


def say(msg=""): print(msg)
def ok(msg): say("%s✅%s %s" % (C["g"], C["x"], msg))
def warn(msg): say("%s⚠️%s  %s" % (C["y"], C["x"], msg))
def err(msg): say("%s❌%s %s" % (C["r"], C["x"], msg))
def head(msg): say("\n%s%s%s" % (C["B"], msg, C["x"]))


def die(msg, code=1):
    err(msg)
    sys.exit(code)


# ---------------------------------------------------------------- registry

DEFAULT_REGISTRY = {"default": None, "gateway_port": GW_PORT_DEFAULT, "upstreams": {}}


def load_registry():
    if not REGISTRY.exists():
        return dict(DEFAULT_REGISTRY, upstreams={})
    return json.loads(REGISTRY.read_text())


def save_registry(reg):
    REGISTRY.write_text(json.dumps(reg, indent=2, ensure_ascii=False) + "\n")


# ---------------------------------------------------------------- .env

def read_env():
    d = {}
    if ENVFILE.exists():
        for line in ENVFILE.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                d[k.strip()] = v.strip()
    return d


def write_env(d):
    lines = ["# 由 `lc` 生成/维护。此文件含密钥，已被 .gitignore 排除，切勿提交。", ""]
    for k in sorted(d):
        lines.append("%s=%s" % (k, d[k]))
    ENVFILE.write_text("\n".join(lines) + "\n")
    try:
        os.chmod(str(ENVFILE), 0o600)
    except OSError:
        pass


ENV_PREFIX = "KEY_"


def env_key_name(name):
    return ENV_PREFIX + re.sub(r"[^A-Z0-9]", "_", name.upper())


def env_header_name(upstream, header):
    """自定义 HTTP 头的值也走 .env，registry 里只留变量名。

    registry.json 是可提交的，而 headers 字段没有任何约束——用户完全可能往里
    塞 Authorization 或某个网关的自定义 token。把值挪进 .env，处理方式就和
    api_key / api_base 一致了。头名里的连字符（User-Agent）要转成下划线，
    否则不是合法的环境变量名。
    """
    return "%s_HEADER_%s" % (env_key_name(upstream),
                             re.sub(r"[^A-Z0-9]", "_", str(header).upper()))


def is_env_ref(v):
    """registry 里这个 header 值是变量名引用，还是早期版本留下的明文？"""
    return isinstance(v, str) and v.startswith(ENV_PREFIX)


def legacy_headers(u):
    """该上游 registry 里仍然是明文的 header 名。"""
    return sorted(k for k, v in (u.get("headers") or {}).items() if not is_env_ref(v))


# ---------------------------------------------------------------- prompts

def ask(label, default=None, secret=False, required=True):
    suffix = ""
    if default:
        shown = default
        if secret and len(default) > 8:
            shown = default[:4] + "…" + default[-3:]
        suffix = " %s[%s]%s" % (C["d"], shown, C["x"])
    while True:
        try:
            v = input("%s%s%s%s: " % (C["b"], label, C["x"], suffix)).strip()
        except (EOFError, KeyboardInterrupt):
            say(); die("已取消", 130)
        if not v and default is not None:
            return default
        if v or not required:
            return v
        warn("不能为空")


def ask_bool(label, default=True):
    d = "Y/n" if default else "y/N"
    try:
        v = input("%s%s%s %s[%s]%s: "
                  % (C["b"], label, C["x"], C["d"], d, C["x"])).strip().lower()
    except (EOFError, KeyboardInterrupt):
        say()
        die("已取消", 130)
    if not v:
        return default
    return v in ("y", "yes", "是")


def ask_int(label, default):
    while True:
        v = ask(label, str(default))
        try:
            return int(v)
        except ValueError:
            warn("请输入数字")


# ---------------------------------------------------------------- generate

def gen_litellm(reg):
    L = []
    L.append("# 本文件由 `lc sync` 自动生成，请勿手改——改动会被覆盖。")
    L.append("# 增删上游请用: lc add / lc rm / lc ls")
    L.append("#")
    L.append("# use_chat_completions_api: true 是关键开关。Codex >= 0.145 只说 Responses")
    L.append("# 协议，而 vLLM 只提供 /v1/chat/completions。不加这个开关，LiteLLM 会把")
    L.append("# /v1/responses 原样透传给上游，上游返回 404 / Unsupported model。")
    L.append("")
    L.append("model_list:")
    for name in sorted(reg["upstreams"]):
        u = reg["upstreams"][name]
        L.append("  - model_name: %s" % name)
        L.append("    litellm_params:")
        L.append("      model: openai/%s" % u["model"])
        L.append("      api_base: os.environ/%s" % (u["env_base"]))
        L.append("      api_key: os.environ/%s" % (u["env_key"]))
        L.append("      use_chat_completions_api: true")
        if u.get("headers"):
            # header 的值和 api_key 一样走 os.environ/：registry 只存变量名。
            # LiteLLM 加载配置时会递归展开嵌套 dict 里的 os.environ/ 引用
            # （proxy_server.ProxyConfig._check_for_os_environ_vars），所以
            # extra_headers 里这么写是生效的。
            L.append("      extra_headers:")
            for k, v in sorted(u["headers"].items()):
                if is_env_ref(v):
                    L.append("        %s: os.environ/%s" % (k, v))
                else:
                    # 早期版本把值明文存在 registry 里，兼容读取；`lc migrate` 可搬走。
                    L.append("        %s: \"%s\"" % (k, v))
        # 额外参数扁平写进 litellm_params，LiteLLM 会原样转发给上游。
        # 实测扁平写法与 extra_body 包一层都生效，扁平的对两种命名约定都适用。
        if u.get("params"):
            L.append(_yaml_block(u["params"], 6))
        L.append("    model_info:")
        L.append("      context_window: %d" % u["context_window"])
        L.append("      max_output_tokens: %d" % u["max_output_tokens"])
        L.append("")
    L.append("litellm_settings:")
    L.append("  drop_params: true")
    L.append("  request_timeout: 600")
    L.append("  num_retries: 2")
    L.append("")
    L.append("general_settings:")
    L.append("  master_key: os.environ/LITELLM_MASTER_KEY")
    LITELLM_CFG.parent.mkdir(exist_ok=True)
    LITELLM_CFG.write_text("\n".join(L) + "\n")


def _yaml_block(obj, indent):
    out = []
    pad = " " * indent
    for k, v in sorted(obj.items()):
        if isinstance(v, dict):
            out.append("%s%s:" % (pad, k))
            out.append(_yaml_block(v, indent + 2))
        elif isinstance(v, bool):
            out.append("%s%s: %s" % (pad, k, "true" if v else "false"))
        elif isinstance(v, (int, float)):
            out.append("%s%s: %s" % (pad, k, v))
        else:
            out.append("%s%s: \"%s\"" % (pad, k, v))
    return "\n".join(out)


def gen_codex(reg):
    CODEX_DIR.mkdir(exist_ok=True)
    port = reg.get("gateway_port", GW_PORT_DEFAULT)
    default = reg.get("default") or (sorted(reg["upstreams"]) or [None])[0]
    base = []
    base.append("# 本文件由 `lc sync` 自动生成，请勿手改。")
    base.append("# 通过 CODEX_HOME 指向本目录加载，不污染 ~/.codex")
    base.append("")
    base.append("model_provider = \"gateway\"")
    if default:
        base.append("model = \"%s\"" % default)
    base.append("")
    base.append("approval_policy = \"never\"")
    base.append("sandbox_mode = \"workspace-write\"")
    base.append("")
    base.append("[model_providers.gateway]")
    base.append("name = \"LiteLLM Gateway\"")
    base.append("base_url = \"http://127.0.0.1:%d/v1\"" % port)
    base.append("env_key = \"LITELLM_MASTER_KEY\"")
    base.append("# Codex >= 0.145 移除了 wire_api=\"chat\"，只剩 responses。")
    base.append("wire_api = \"responses\"")
    (CODEX_DIR / "config.toml").write_text("\n".join(base) + "\n")

    for f in CODEX_DIR.glob("*.config.toml"):
        f.unlink()
    for name in sorted(reg["upstreams"]):
        u = reg["upstreams"][name]
        (CODEX_DIR / ("%s.config.toml" % name)).write_text(
            "# 由 `lc sync` 生成。profile: %s\n"
            "model = \"%s\"\n"
            "model_provider = \"gateway\"\n\n"
            "# 上下文预算。注意：这不会消除 Codex 那句 \"Model metadata not found\"\n"
            "# 警告（它来自 Codex 内置的模型注册表），但确实决定截断策略。\n"
            "model_context_window = %d\n"
            "model_max_output_tokens = %d\n\n"
            "# 显式注册 apply_patch 工具。不开的话，模型自发调用它会报\n"
            "# \"unsupported call: apply_patch\"，然后退化成用 shell heredoc 写文件——\n"
            "# 既容易转义出错，也读不到结构化 diff。\n"
            "include_apply_patch_tool = true\n\n"
            "# 已在网关侧关闭思考模式，这里同步告知 Codex 不要索要 reasoning 元数据。\n"
            "model_supports_reasoning_summaries = false\n"
            % (name, name, u["context_window"], u["max_output_tokens"]))


def sync(reg=None, quiet=False):
    reg = reg or load_registry()
    if not reg["upstreams"]:
        die("还没有任何上游，先跑 `lc add`")
    gen_litellm(reg)
    gen_codex(reg)
    warn_legacy_headers(reg)
    if not quiet:
        ok("已生成 litellm/config.yaml 与 codex/*.config.toml (%d 个上游)"
           % len(reg["upstreams"]))


def warn_legacy_headers(reg):
    """registry 里还有明文 header 值时提醒。

    不在 sync 里静默迁移：sync 被 `lc up` / `lc use` / `lc rm` 隐式调用，
    它应该是「registry -> 配置」的纯生成器；让它顺手改写 registry 和 .env，
    等于 `lc up` 会悄悄动你的凭证文件。所以只警告，搬运交给显式的 lc migrate。
    这条警告无视 quiet，因为它说的是泄漏面。
    """
    stale = [(n, legacy_headers(reg["upstreams"][n])) for n in sorted(reg["upstreams"])]
    stale = [(n, ks) for n, ks in stale if ks]
    if not stale:
        return
    warn("registry.json 里还有明文 header 值：")
    for n, ks in stale:
        say("   %s: %s" % (n, ", ".join(ks)))
    say("   %sregistry.json 是可提交的，header 值应当只存在 .env 里。"
        "跑 `lc migrate` 搬运。%s" % (C["d"], C["x"]))


# ---------------------------------------------------------------- docker

def compose(*args, **kw):
    return subprocess.call(["docker", "compose"] + list(args), cwd=str(ROOT), **kw)


def gw_url(reg=None):
    reg = reg or load_registry()
    return "http://127.0.0.1:%d" % reg.get("gateway_port", GW_PORT_DEFAULT)


def gw_alive(reg=None):
    import urllib.request
    try:
        urllib.request.urlopen(gw_url(reg) + "/health/liveliness", timeout=5).read()
        return True
    except Exception:
        return False


def gw_wait_tries():
    """`lc up` 等网关就绪的轮数（每轮约 1 秒），可用 LC_GATEWAY_WAIT 覆盖。

    45 秒对慢内网机器不够，对本机又太长，而这个值原来是写死的常量，唯一的调节
    手段是改代码。开成环境变量而不是 `lc up --wait`：`lc` 的命令行参数一直很
    克制，而这个旋钮真正的用处是「这台机器慢，我要调大」——那属于机器的属性，
    适合放在环境里，不是每次敲命令都带一遍。

    值不合法时不静默回落：这个项目里「静默回落」已经坑过人（Codex 对不存在的
    profile 就是静默回落到默认 model），所以说一句再用默认值。
    """
    raw = os.environ.get("LC_GATEWAY_WAIT", "").strip()
    if not raw:
        return GW_WAIT_DEFAULT
    try:
        n = int(raw)
    except ValueError:
        n = 0
    if n <= 0:
        warn("LC_GATEWAY_WAIT=%r 不是正整数，按默认 %d 秒等待"
             % (raw, GW_WAIT_DEFAULT))
        return GW_WAIT_DEFAULT
    return n


def wait_gw(reg, tries=None):
    import time
    tries = GW_WAIT_DEFAULT if tries is None else tries
    for i in range(tries):
        if gw_alive(reg):
            return i + 1
        time.sleep(1)
    return None


# ---------------------------------------------------------------- commands

def cmd_init(argv):
    head("airgap-coder 初始化")
    reg = load_registry()
    env = read_env()

    if not env.get("LITELLM_MASTER_KEY"):
        import secrets
        env["LITELLM_MASTER_KEY"] = "sk-lc-" + secrets.token_hex(16)
        ok("已生成网关 master key")
    reg["gateway_port"] = ask_int("网关端口", reg.get("gateway_port", GW_PORT_DEFAULT))
    write_env(env)
    save_registry(reg)

    if reg["upstreams"]:
        # 团队场景：registry.json 随仓库下发，结构参数（模型 ID、上下文窗口、
        # 关思考模式的参数名）对所有人都一样，只有地址和密钥因人而异。
        # 新人不该被迫重新踩一遍结构参数的坑，所以这里只补 .env 里缺的那部分。
        say()
        ok("检测到已有 registry.json（%d 个上游），结构参数直接沿用。" % len(reg["upstreams"]))
        say("只需要填你本机的地址与密钥——这两样只写进 .env。")
        for name in sorted(reg["upstreams"]):
            _fill_secrets(name, reg["upstreams"][name], env)
        write_env(env)
        more = ask_bool("再添加一个新上游?", False)
    else:
        say()
        say("接下来添加模型上游。内网 vLLM 直接填它的 /v1 地址。")
        more = True
    while more:
        _add_one(reg, env)
        more = ask_bool("再加一个上游?", False)
    if not reg.get("default"):
        reg["default"] = sorted(reg["upstreams"])[0]
    save_registry(reg)
    write_env(env)
    sync(reg)
    say()
    ok("初始化完成。默认上游: %s" % reg["default"])
    say("下一步: %slc up%s  然后  %slc test%s" % (C["B"], C["x"], C["B"], C["x"]))


def _ask_base(label, default=None):
    base = ask(label, default).rstrip("/")
    if not base.endswith("/v1"):
        warn("地址通常以 /v1 结尾，你填的是: %s" % base)
    return base


def _fill_secrets(name, u, env):
    """已有上游：只问 .env 里那几项（地址、key、header 值），不重问结构参数。"""
    head("上游 '%s'  %s(model=%s ctx=%d)%s"
         % (name, C["d"], u["model"], u["context_window"], C["x"]))
    env[u["env_base"]] = _ask_base("Base URL（到 /v1 为止）", env.get(u["env_base"]) or None)
    env[u["env_key"]] = ask("API Key", env.get(u["env_key"]) or None, secret=True)
    for hk in sorted(u.get("headers") or {}):
        ref = u["headers"][hk]
        if not is_env_ref(ref):
            continue  # 明文遗留值，归 lc migrate 管，这里不动
        env[ref] = ask("  HTTP 头 %s 的值" % hk, env.get(ref) or None)


def _drop_orphan_headers(old, headers, env):
    """覆盖同名上游时，把新定义不再引用的 header 变量从 .env 里清掉。

    header 变量名由「上游名 + 头名」派生，所以头名一改或那个头被去掉，旧变量
    就没有任何配置引用它了，而 write_env 会原样把它写回去——一个不再被引用的
    凭证值留在磁盘上，还会被 docker-compose 的 env_file 一直注入网关容器。
    env_key / env_base 没有这个问题：变量名只由上游名派生，同名覆盖时正好被
    新值盖掉。cmd_rm 早就是这么清的，缺的只是 add 的覆盖分支。

    `ref not in keep` 不能省：头名没变时新旧引用是同一个变量名，而新值在这之前
    就已经写进 env 了，无条件 pop 等于把用户刚输入的值删掉。
    """
    keep = set(headers.values())
    gone = sorted(set(ref for ref in (old.get("headers") or {}).values()
                      if is_env_ref(ref) and ref not in keep))
    for ref in gone:
        env.pop(ref, None)
    if gone:
        say("  %s已从 .env 移除不再被引用的 header 变量: %s%s"
            % (C["d"], ", ".join(gone), C["x"]))


def _add_one(reg, env):
    head("添加上游")
    name = ask("名称（英文，用作 profile 名，如 intranet-32b）")
    old = reg["upstreams"].get(name)
    if old is not None and not ask_bool("'%s' 已存在，覆盖?" % name, False):
        return
    base = _ask_base("Base URL（到 /v1 为止，如 https://your-intranet.local:8000/v1）")
    model = ask("上游模型 ID（发给后端的 model 字段，如 qwen3-32b）")
    key = ask("API Key", secret=True)
    ctx = ask_int("上下文窗口 (tokens)", 131072)
    out = ask_int("最大输出 (tokens)", 16384)

    say()
    say("  后端类型决定关闭思考模式的参数名（两家约定不同）:")
    say("    1) vLLM / SGLang     -> chat_template_kwargs.enable_thinking")
    say("    2) 托管服务(百炼/Ark) -> 顶层 enable_thinking")
    say("    3) 不设置")
    kind = ask("选择", "1")
    params = {}
    if kind == "1":
        params["chat_template_kwargs"] = {"enable_thinking": False}
    elif kind == "2":
        params["enable_thinking"] = False
    if params:
        say("  %s思考模式会输出 <think> 块，干扰 Codex 的 tool call 解析，建议关闭。%s"
            % (C["d"], C["x"]))

    headers = {}
    if ask_bool("需要自定义 HTTP 头? (如 Kimi 要求 User-Agent)", False):
        while True:
            hk = ask("头名称（留空结束）", required=False)
            if not hk:
                break
            hn = env_header_name(name, hk)
            env[hn] = ask("  %s 的值 %s(存入 .env/%s)%s" % (hk, C["d"], hn, C["x"]))
            headers[hk] = hn

    ek, eb = env_key_name(name), env_key_name(name) + "_BASE"
    env[ek] = key
    env[eb] = base
    if old:
        _drop_orphan_headers(old, headers, env)
    reg["upstreams"][name] = {
        "model": model, "env_key": ek, "env_base": eb,
        "context_window": ctx, "max_output_tokens": out,
        "params": params, "headers": headers,
    }
    if not reg.get("default"):
        reg["default"] = name
    save_registry(reg)
    write_env(env)
    ok("已添加上游 '%s'" % name)


def cmd_add(argv):
    reg, env = load_registry(), read_env()
    _add_one(reg, env)
    sync(reg)


def cmd_ls(argv):
    reg = load_registry()
    if not reg["upstreams"]:
        warn("还没有上游。跑 `lc init` 或 `lc add`")
        return
    env = read_env()
    head("上游列表  (默认: %s)" % (reg.get("default") or "无"))
    for name in sorted(reg["upstreams"]):
        u = reg["upstreams"][name]
        mark = "%s*%s" % (C["g"], C["x"]) if name == reg.get("default") else " "
        p = u.get("params", {})
        think = p.get("enable_thinking",
                      p.get("chat_template_kwargs", {}).get("enable_thinking"))
        flags = []
        if think is False:
            flags.append("thinking=off")
        if u.get("headers"):
            flags.append("headers=%d" % len(u["headers"]))
        say("%s %s%-20s%s %s" % (mark, C["B"], name, C["x"], u["model"]))
        say("   %s%s%s" % (C["d"], env.get(u["env_base"], "?"), C["x"]))
        say("   %sctx=%d out=%d %s%s" % (C["d"], u["context_window"],
                                         u["max_output_tokens"], " ".join(flags), C["x"]))


def cmd_use(argv):
    if not argv:
        die("用法: lc use <name>")
    reg = load_registry()
    if argv[0] not in reg["upstreams"]:
        die("没有上游 '%s'。可用: %s" % (argv[0], ", ".join(sorted(reg["upstreams"]))))
    reg["default"] = argv[0]
    save_registry(reg)
    sync(reg, quiet=True)
    ok("默认上游已切换为 %s" % argv[0])


def cmd_rm(argv):
    if not argv:
        die("用法: lc rm <name>")
    reg, env = load_registry(), read_env()
    u = reg["upstreams"].pop(argv[0], None)
    if not u:
        die("没有上游 '%s'" % argv[0])
    env.pop(u["env_key"], None)
    env.pop(u["env_base"], None)
    for ref in (u.get("headers") or {}).values():
        if is_env_ref(ref):
            env.pop(ref, None)
    if reg.get("default") == argv[0]:
        reg["default"] = sorted(reg["upstreams"])[0] if reg["upstreams"] else None
    save_registry(reg)
    write_env(env)
    if reg["upstreams"]:
        sync(reg, quiet=True)
    ok("已删除 '%s'" % argv[0])


def cmd_up(argv):
    reg = load_registry()
    sync(reg, quiet=True)
    compose("up", "-d", "--force-recreate")
    tries = gw_wait_tries()
    n = wait_gw(reg, tries)
    if n:
        ok("网关就绪 (%ds) %s" % (n, gw_url(reg)))
    else:
        # 超时数从 tries 里来，不写死：调过 LC_GATEWAY_WAIT 的人看到的必须是
        # 实际等了多久，否则这句话会把人引到错误的方向。
        err("网关未在 %ds 内就绪，看日志: lc logs" % tries)
        if tries == GW_WAIT_DEFAULT:
            say("  %s机器慢的话可以调大：LC_GATEWAY_WAIT=120 lc up%s"
                % (C["d"], C["x"]))


def cmd_down(argv):
    compose("down")


def cmd_logs(argv):
    compose("logs", "-f", *argv)


def cmd_status(argv):
    reg = load_registry()
    compose("ps")
    say()
    if gw_alive(reg):
        ok("网关存活 %s" % gw_url(reg))
    else:
        err("网关无响应")


def _run_py(script, args):
    env = dict(os.environ)
    env["CODEX_HOME"] = str(CODEX_DIR)
    return subprocess.call([sys.executable, str(ROOT / "scripts" / script)] + args, env=env)


def cmd_test(argv):
    reg = load_registry()
    names = argv or [reg.get("default")]
    rc = 0
    for n in names:
        rc |= _run_py("smoke.py", [n])
    sys.exit(rc)


def cmd_e2e(argv):
    reg = load_registry()
    names = argv or [reg.get("default")]
    rc = 0
    for n in names:
        rc |= subprocess.call([str(ROOT / "scripts" / "test-codex.sh"), n])
    sys.exit(rc)


def cmd_code(argv):
    reg = load_registry()
    if not gw_alive(reg):
        die("网关没起来，先跑 `lc up`")
    env = dict(os.environ)
    env["CODEX_HOME"] = str(CODEX_DIR)
    env.update(read_env())
    profile = reg.get("default")
    sys.exit(subprocess.call(["codex", "--profile", profile] + list(argv), env=env))


def _dockerfile_codex_version():
    """ARG CODEX_VERSION pinned in docker/Dockerfile (airgap lock)."""
    df = ROOT / "docker" / "Dockerfile"
    if not df.is_file():
        return None
    for line in df.read_text(encoding="utf-8").splitlines():
        m = re.match(r"\s*ARG\s+CODEX_VERSION=(\S+)", line)
        if m:
            return m.group(1).strip().strip('"').strip("'")
    return None


def _local_codex_version():
    """`codex --version` 里的版本号；没装 / 跑不起来 / 解析不出来都返回 None。

    解析不出来时不能把随便一段文本当版本号返回——那会让比对逻辑打出一句
    「本机 Codex xxx 与 ... 不一致」的怪话。返回 None，交给降级分支处理。
    """
    p = shutil.which("codex")
    if not p:
        return None
    try:
        out = subprocess.check_output(
            [p, "--version"], text=True, stderr=subprocess.STDOUT, timeout=10
        )
    except Exception:
        return None
    m = re.search(r"(\d+\.\d+(?:\.\d+)?)", out)
    return m.group(1) if m else None


def _same_version(a, b):
    """按段比对两个版本号。

    不能用前缀匹配：`codex --version` 只吐出 `0.14` 时，
    `"0.145.0".startswith("0.14")` 会把它判成「一致」——而这恰恰是本检查
    要防的静默通过。补零到三段后按整数元组比，`0.145` == `0.145.0`，
    但 `0.14` != `0.145.0`。
    """
    def parts(v):
        seg = re.findall(r"\d+", v)[:3]
        return tuple(int(x) for x in seg) + (0,) * (3 - len(seg))
    return parts(a) == parts(b)


def cmd_doctor(argv):
    reg = load_registry()
    head("环境体检")
    for tool in ("docker", "codex"):
        p = shutil.which(tool)
        ok("%s: %s" % (tool, p)) if p else err("%s 未安装" % tool)

    pinned = _dockerfile_codex_version()
    if pinned:
        local = _local_codex_version()
        if not local:
            # codex 没装的话上面那行已经报过了，这里只说版本读不出来的情况
            if shutil.which("codex"):
                warn("无法读取本机 codex --version；Dockerfile 锁定 %s" % pinned)
        elif _same_version(local, pinned):
            ok("codex 版本与 Dockerfile 锁定一致 (%s)" % pinned)
        else:
            warn("本机 Codex %s 与 Dockerfile 锁定的 %s 不一致" % (local, pinned))
            say("   %s协议层差异可能导致「本地正常、容器失败」。%s" % (C["d"], C["x"]))
            say("   %s对齐: npm i -g @openai/codex@%s%s" % (C["d"], pinned, C["x"]))

    proxies = [k for k in ("HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY",
                           "http_proxy", "https_proxy", "all_proxy") if os.environ.get(k)]
    if proxies:
        warn("检测到代理环境变量: %s" % ", ".join(proxies))
        say("   %s内网地址可能被代理劫持。给内网域名加 DIRECT 规则，或设 NO_PROXY。%s"
            % (C["d"], C["x"]))
    else:
        ok("无代理环境变量")

    env = read_env()
    if env.get("LITELLM_MASTER_KEY"):
        ok("master key 已设置")
    else:
        err("缺 LITELLM_MASTER_KEY，跑 `lc init`")

    if not reg["upstreams"]:
        err("没有配置上游")
    else:
        ok("%d 个上游，默认 %s" % (len(reg["upstreams"]), reg.get("default")))
        warn_legacy_headers(reg)

    if gw_alive(reg):
        ok("网关存活 %s" % gw_url(reg))
    else:
        warn("网关未运行（`lc up` 启动）")

    head("上游直连探测（绕过网关，带 tools）")
    say("%s只测「连得上」是不够的：内网最常见的失败是连得上、聊天正常、"
        "tool_calls 恒为空。%s" % (C["d"], C["x"]))
    for name in sorted(reg["upstreams"]):
        _probe_upstream(name, reg["upstreams"][name], env)


def _probe_upstream(name, u, env):
    """直连一个上游，断言 tool calling 真的生效（而不只是 200）。"""
    import urllib.error
    import urllib.request

    scripts = str(ROOT / "scripts")
    if scripts not in sys.path:
        sys.path.insert(0, scripts)
    try:
        # 判据与 scripts/smoke.py 共用一份，避免两边结论打架
        import probe
    except ImportError as e:
        err("读不到 scripts/probe.py，无法探测 %s: %s" % (name, e))
        return

    base = env.get(u["env_base"], "")
    if not base:
        err("%s: .env 里没有 %s，不知道它的地址" % (name, u["env_base"]))
        return

    headers = {"Authorization": "Bearer " + env.get(u["env_key"], ""),
               "Content-Type": "application/json"}
    # 带上该上游登记的自定义头与额外参数（如关思考模式的开关），
    # 否则 doctor 打出去的请求和网关实际发出的请求不是同一个配置，
    # 探测结论迁移不到真实链路上。
    for k, v in (u.get("headers") or {}).items():
        hv = env.get(v) if is_env_ref(v) else v
        if not hv:
            err("%s: .env 里没有 %s（HTTP 头 %s 的值），跑 `lc init` 补上" % (name, v, k))
            return
        headers[str(k)] = str(hv)
    payload = probe.chat_payload(u["model"], u.get("params"))

    req = urllib.request.Request(base + "/chat/completions",
                                 data=json.dumps(payload).encode(),
                                 headers=headers, method="POST")
    try:
        raw = urllib.request.urlopen(req, timeout=60).read()
    except urllib.error.HTTPError as e:
        body = e.read()[:200].decode("utf8", "replace")
        if e.code in (401, 403):
            err("%s HTTP %s —— 鉴权失败，核对 .env 里的 %s" % (name, e.code, u["env_key"]))
        elif e.code == 404:
            err("%s HTTP 404 —— 地址或模型 ID 不对。核对 .env 的 %s（要到 /v1 为止）"
                "与 registry 里的 model=%s" % (name, u["env_base"], u["model"]))
        elif e.code == 400:
            err("%s HTTP 400 —— 上游拒绝了带 tools 的请求" % name)
            say("   %s↳ 怎么修: %s%s" % (C["d"], probe.hint("tools_request_failed"), C["x"]))
        else:
            warn("%s HTTP %s" % (name, e.code))
        say("   %s%s%s" % (C["d"], body, C["x"]))
        return
    except Exception as e:
        err("%s 不可达: %s" % (name, e))
        say("   %s↳ 怎么修: %s%s" % (C["d"], probe.hint("chat_failed"), C["x"]))
        return

    try:
        resp = json.loads(raw.decode("utf8", "replace"))
    except ValueError:
        err("%s 返回 200 但不是 JSON" % name)
        say("   %s↳ 怎么修: %s%s" % (C["d"], probe.hint("bad_response"), C["x"]))
        return

    good, key, detail = probe.check_tool_call(resp)
    if good:
        ok("%s 可达，tool calling 生效 (%s)" % (name, detail))
    else:
        err("%s %s" % (name, probe.title(key)))
        if detail:
            say("   %s%s%s" % (C["d"], str(detail)[:200], C["x"]))
        say("   %s↳ 怎么修: %s%s" % (C["d"], probe.hint(key), C["x"]))

    # 思考模式不算错误，但 <think> 块会干扰 tool call 解析，值得提示。
    leak = probe.reasoning_leak(resp)
    if leak:
        warn("%s 思考模式似乎还开着（%s）" % (name, leak))
        if u.get("params"):
            say("   %s已配 %s，但上游没认——参数名很可能选错了。%s"
                % (C["d"], ", ".join(sorted(u["params"])), C["x"]))
        else:
            say("   %s该上游没配关思考模式的参数。%s" % (C["d"], C["x"]))
        say("   %s↳ 怎么修: %s%s" % (C["d"], probe.hint("thinking_on"), C["x"]))


def cmd_sync(argv):
    sync()


# ------------------------------------------------------------------ export
#
# 这是整个项目唯一一次真正的隔离网穿越（issue #5）：产物离开有外网的机器，
# 到内网就没有补救手段了。所以这里的取舍一律偏保守：
#   - 源码清单用 `git ls-files`，天然尊重 .gitignore，不手写排除列表；
#   - 打完包再显式断言敏感路径不在包里（纵深防御，不只依赖 gitignore 正确）；
#   - MANIFEST 记镜像 digest 而不只是 tag；即使 compose 已钉 digest，导出时仍
#     记录本机实际镜像身份，便于在隔离网两侧复核；
#   - 镜像 tar 是 GB 级，流式落盘，不进内存。

# 不管 git 怎么说，这些路径永远不进包。
#
# registry.json 不在这里（issue #16）：issue #4 之后它只存结构定义与变量名，
# 而内网侧恰恰最需要那份结构——模型 ID、上下文窗口、关思考模式的参数名，
# 填错了不报错只静默失效，而内网没有外网可查、也没有别人的 registry 可要。
# 「打进包会泄漏」这个顾虑由 registry 里不许有明文值这条不变量兜住（ci.yml 的
# registry 扫描 + 下面 _registry_leaks 的导出前复核）。不想带的用 --no-registry。
BUNDLE_NEVER = (".env", ".env.local", "litellm/config.yaml")
BUNDLE_NEVER_DIRS = ("codex/", ".smoke/", ".codex-review/", ".git/")


def _compose_litellm_image():
    """docker-compose.yml 里 litellm 服务用的镜像（含 tag 或 digest）。

    按服务名定位，不是取第一条 `image:`。compose 里将来多一个服务（比如加个
    反向代理），「取第一条」会静默把错的镜像打进包，而这种错要到内网才发现。
    定位不到就返回 None，让调用方明确报错——宁可打不出包，也不要打错包。
    """
    f = ROOT / "docker-compose.yml"
    if not f.is_file():
        return None
    service, svc_indent, in_services = None, None, False
    for line in f.read_text(encoding="utf-8").splitlines():
        if re.match(r"services:\s*$", line):
            in_services = True
            continue
        if not in_services:
            continue
        m = re.match(r"(\s+)([A-Za-z0-9._-]+):\s*$", line)
        if m and (svc_indent is None or len(m.group(1)) == svc_indent):
            svc_indent = len(m.group(1))
            service = m.group(2)
            continue
        m = re.match(r"\s+image:\s*(\S+)", line)
        if m and service == "litellm":
            return m.group(1).strip().strip('"').strip("'")
    return None


def _sha256(path):
    import hashlib
    h = hashlib.sha256()
    with open(str(path), "rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def _sha256_text(text):
    """包里现生成的那几个文件（MANIFEST.txt / install.sh）的 sha256。

    它们不落盘，直接从字节算——和 add_bytes 用同一份 utf-8 编码，否则清单里
    的值和包里的内容会对不上。
    """
    import hashlib
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def _image_digest(ref):
    """镜像的 RepoDigest（sha256:...）。拿不到返回 None。"""
    try:
        out = subprocess.check_output(
            ["docker", "image", "inspect", "--format",
             "{{if .RepoDigests}}{{index .RepoDigests 0}}{{end}}", ref],
            text=True, stderr=subprocess.DEVNULL, timeout=30)
    except Exception:
        return None
    out = out.strip()
    return out.split("@", 1)[1] if "@" in out else None


def _image_exists(ref):
    try:
        return subprocess.call(["docker", "image", "inspect", ref],
                               stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL) == 0
    except Exception:
        return False


def _docker_save(ref, dest):
    """流式 `docker save` 到 dest（gzip）。镜像是 GB 级，不能进内存。"""
    import gzip
    with gzip.open(str(dest), "wb") as out:
        p = subprocess.Popen(["docker", "save", ref], stdout=subprocess.PIPE)
        try:
            while True:
                chunk = p.stdout.read(1024 * 1024)
                if not chunk:
                    break
                out.write(chunk)
        finally:
            p.stdout.close()
            rc = p.wait()
    if rc != 0:
        die("docker save %s 失败（退出码 %d）" % (ref, rc))


def _registry_leaks():
    """registry.json 里还有明文凭证吗？返回「上游: 头名」列表。

    带 registry 进包之前必须复核一遍：早期版本把自定义头的值明文存在 registry
    里（`lc migrate` 负责搬走），那种 registry 一旦跟着包跨网走，就是把凭证
    塞进一个宣称「不含任何机密」的产物里。这是导出路径上唯一一次机会——
    到了内网没有补救手段。
    """
    if not REGISTRY.is_file():
        return []
    try:
        reg = json.loads(REGISTRY.read_text())
    except ValueError as e:
        die("registry.json 不是合法 JSON（%s），拒绝把它打进包" % e)
    bad = []
    for name in sorted(reg.get("upstreams") or {}):
        for hk in legacy_headers(reg["upstreams"][name]):
            bad.append("%s: %s" % (name, hk))
    return bad


def _tracked_files(never=BUNDLE_NEVER):
    """git 认为该带走的文件。用它而不是手写排除列表——.gitignore 已经是唯一真相。"""
    try:
        out = subprocess.check_output(["git", "ls-files", "-z"], cwd=str(ROOT),
                                      text=True, stderr=subprocess.STDOUT)
    except Exception as e:
        die("跑不了 `git ls-files`（%s）。lc export 需要在 git 仓库里执行。" % e)
    files = [f for f in out.split("\0") if f]
    if not files:
        die("`git ls-files` 没列出任何文件，拒绝打一个空包")
    keep = []
    for f in files:
        if f in never or f.startswith(BUNDLE_NEVER_DIRS):
            continue
        if (ROOT / f).is_file():
            keep.append(f)
    return keep


INSTALL_SH = """#!/usr/bin/env bash
# 内网侧安装脚本。由 `lc export` 生成，不要手改。
set -euo pipefail
cd "$(dirname "$0")"

echo "== airgap-coder 离线包安装 =="

if ! command -v docker >/dev/null 2>&1; then
  echo "❌ 没有 docker，先装 docker 再来" >&2
  exit 1
fi

# 先核完整性：跨网搬运最常见的事故是 tar 传坏了或传了半个。
# SHA256SUMS 覆盖包内每一个文件，不只是镜像 tar——bin/lc 和 scripts/ 是这台
# 机器上马上要执行的东西，它们比镜像更需要核。解包到一半被打断（磁盘满、
# 介质拔出）会留下一个看起来正常、实际缺文件的目录，这一步就是抓它的。
if command -v sha256sum >/dev/null 2>&1; then
  CHECK="sha256sum -c"
elif command -v shasum >/dev/null 2>&1; then
  CHECK="shasum -a 256 -c"
else
  CHECK=""
fi
if [ -n "$CHECK" ] && [ -f SHA256SUMS ]; then
  echo "-- 校验 sha256（包内全部文件）"
  # 不直接把 $CHECK 的输出打出来：现在是几十行 OK，真出问题的那一两行会被刷掉。
  # 失败时再把非 OK 的行原样打出来，说清是哪个文件。
  if sums_out="$($CHECK SHA256SUMS 2>&1)"; then
    echo "   ✅ $(grep -c '' SHA256SUMS) 个文件校验通过"
  else
    printf '%s\\n' "$sums_out" | grep -v ': OK$' >&2 || true
    echo "❌ sha256 校验失败：包在传输或解包过程中损坏了，不要继续安装" >&2
    echo "   重新完整传一遍整包，或找打包方核对 SHA256SUMS" >&2
    exit 1
  fi
else
  echo "⚠️  跳过 sha256 校验（没有 sha256sum/shasum 或缺 SHA256SUMS）"
fi

for tar in images/*.tar.gz; do
  [ -e "$tar" ] || { echo "⚠️  包里没有镜像 tar（--no-images 导出的包），跳过 docker load"; break; }
  echo "-- docker load $tar"
  gunzip -c "$tar" | docker load
done

echo
echo "✅ 镜像已就位。在当前目录接着跑："
echo "   ./bin/lc init      # __INIT_HINT__"
echo "   ./bin/lc up        # 起网关"
echo "   ./bin/lc doctor    # 体检：连通性 + tool calling 真的生效"
echo "   ./bin/lc code      # 开始用"
echo
echo "镜像名、版本与 digest 见 MANIFEST.txt。"
"""


def cmd_export(argv):
    """打一个可搬运进内网的自包含离线包。"""
    import datetime
    import io
    import tarfile
    import tempfile

    out_path, want_images, want_registry = None, True, True
    rest = list(argv)
    while rest:
        a = rest.pop(0)
        if a == "--no-images":
            want_images = False
        elif a == "--no-registry":
            want_registry = False
        elif a == "--out":
            if not rest:
                die("--out 后面要跟路径")
            out_path = rest.pop(0)
        elif a.startswith("--out="):
            out_path = a.split("=", 1)[1]
        else:
            die("未知参数 '%s'。用法: "
                "lc export [--out 路径] [--no-images] [--no-registry]" % a)

    codex_ver = _dockerfile_codex_version()
    if not codex_ver:
        die("读不到 docker/Dockerfile 里的 ARG CODEX_VERSION，无法确定镜像版本")
    litellm_ref = _compose_litellm_image()
    if not litellm_ref:
        die("读不到 docker-compose.yml 里的 litellm 镜像名")
    dev_ref = "airgap-coder:%s" % codex_ver

    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    bundle_name = "airgap-coder-%s-%s" % (codex_ver, stamp)
    out = pathlib.Path(out_path).expanduser() if out_path else \
        ROOT / ("%s.tar.gz" % bundle_name)
    out = out.resolve()

    head("导出离线包")
    say("  开发镜像 : %s" % dev_ref)
    say("  网关镜像 : %s" % litellm_ref)
    say("  产物     : %s" % out)

    images = []
    if want_images:
        for ref, fname in ((dev_ref, "airgap-coder.tar.gz"),
                           (litellm_ref, "litellm.tar.gz")):
            if _image_exists(ref):
                images.append((ref, fname))
                continue
            err("本机没有镜像 %s" % ref)
            if ref == dev_ref:
                say("   %s先构建: docker build -t %s -f docker/Dockerfile .%s"
                    % (C["d"], dev_ref, C["x"]))
            else:
                say("   %s先拉取: docker pull %s%s" % (C["d"], ref, C["x"]))
            die("镜像不全，拒绝打一个到了内网才发现缺东西的包"
                "（只要源码可以加 --no-images）")
    else:
        warn("--no-images：包里不含镜像，内网侧需要已经 docker load 过")

    # registry.json 只存结构定义与变量名，所以默认跟着包走：内网侧最需要的就是
    # 这份结构（模型 ID / 上下文窗口 / 关思考模式的参数名），而那台机器没有外网
    # 可查、也没有别人的 registry 可要。带之前先复核它确实不含明文凭证。
    never = BUNDLE_NEVER if want_registry else BUNDLE_NEVER + ("registry.json",)
    files = _tracked_files(never)
    if want_registry and REGISTRY.is_file():
        leaks = _registry_leaks()
        if leaks:
            err("registry.json 里还有明文 header 值，拒绝把它打进包：")
            for x in leaks:
                say("   %s" % x)
            die("先跑 `lc migrate` 把这些值搬进 .env（再轮换对应凭证），"
                "或者用 `lc export --no-registry` 打一个不含 registry 的包")
        if "registry.json" not in files:
            # 未提交的 registry.json 也要带走：站点通常是在打包机上跑 lc init
            # 现生成它，那份文件不在 `git ls-files` 里，但正是内网侧要沿用的那份。
            files.append("registry.json")
    bundled_registry = "registry.json" in files
    tmpdir = pathlib.Path(tempfile.mkdtemp(prefix="lc-export-"))
    try:
        # 镜像先落盘到临时目录，边算 sha256 边记 digest
        entries = []
        for ref, fname in images:
            say("  docker save %s ..." % ref)
            tar_path = tmpdir / fname
            _docker_save(ref, tar_path)
            entries.append({
                "file": "images/" + fname, "image": ref,
                "digest": _image_digest(ref) or "(本地构建，无 RepoDigest)",
                "bytes": tar_path.stat().st_size,
                "sha256": _sha256(tar_path),
            })

        lines = [
            "airgap-coder 离线包",
            "",
            "导出时间   : %s" % datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S %z").strip(),
            "包名       : %s" % bundle_name,
            "Codex 版本 : %s  (docker/Dockerfile 的 ARG CODEX_VERSION)" % codex_ver,
            "源码文件数 : %d  (git ls-files，已排除 .env 与生成的配置)" % len(files),
            "",
            "上游注册表:",
        ]
        # 这段措辞是给内网侧的人读的：registry.json 和 .env 的性质完全不同，
        # 并排写在「已排除」里会让人以为它也含凭证（issue #16）。
        if bundled_registry:
            lines += [
                "  registry.json 已包含。它只有结构定义：模型 ID、上下文窗口、",
                "  最大输出、关思考模式的参数形态，以及 KEY_* 变量名。",
                "  它不含任何凭证——地址与 API Key 在你自己要写的 .env 里。",
                "  内网侧跑 `lc init` 时会认出这些上游，只问地址和密钥。",
                "  如果其中某个上游在本内网根本连不上（比如打包机上用来做对比的",
                "  托管服务），用 `lc rm <名称>` 删掉即可。",
            ]
        elif want_registry:
            lines += [
                "  本包不含 registry.json（打包机上没有这个文件）。",
                "  内网侧需要跑 `lc init` 完整配置：模型 ID、上下文窗口、",
                "  后端类型（决定关闭思考模式的参数名）都要现填。",
            ]
        else:
            lines += [
                "  本包不含 registry.json（--no-registry 导出）。",
                "  内网侧需要跑 `lc init` 完整配置，或另行获取一份 registry.json",
                "  放到解包目录根部再跑 `lc init`。",
            ]
        lines += [
            "",
            "镜像:",
        ]
        if entries:
            for e in entries:
                lines += [
                    "  %s" % e["image"],
                    "    文件   : %s" % e["file"],
                    "    digest : %s" % e["digest"],
                    "    大小   : %d 字节" % e["bytes"],
                    "    sha256 : %s" % e["sha256"],
                ]
        else:
            lines.append("  （本包不含镜像，--no-images 导出）")
        lines += [
            "",
            "digest 是镜像的唯一标识；tag 不是。当前引用为 %s。" % litellm_ref,
            "即使 tag 与 digest 同时存在，内网侧仍应以 digest 为准。",
            "",
            "完整性:",
            "  SHA256SUMS 覆盖包内每一个文件，共 %d 项：源码 %d 个、镜像 tar %d 个，"
            % (len(files) + len(entries) + 2, len(files), len(entries)),
            "  以及本文件与 install.sh 自身。解包后 ./install.sh 第一步就会核一遍。",
            "  它挡的是传输损坏与不完整解包，不是篡改——有权改包的人可以连",
            "  SHA256SUMS 一起改。防篡改要看 release 那条链路上的构建证明。",
            "",
            "内网侧: 解包后跑 ./install.sh，然后 ./bin/lc init",
            "",
            "本包不含 .env。地址与密钥永远不跨网搬运，由内网侧现填。",
        ]
        manifest = "\n".join(lines) + "\n"
        install_sh = INSTALL_SH.replace(
            "__INIT_HINT__",
            "registry.json 已在包里，只需填地址与你的 API Key"
            if bundled_registry else
            "本包不含 registry.json，需完整配置（模型 ID / 上下文窗口 / 后端类型）")

        # SHA256SUMS 覆盖包内除它自己以外的每一个文件（issue #26）。以前只有镜像
        # tar 那两行：于是「要 docker load 的镜像」被校验，而「内网侧要直接执行的
        # bin/lc、docker/entrypoint.sh、scripts/*.py」一个都没有——覆盖面的分配
        # 是反的。`--no-images` 的包更是连 SHA256SUMS 都不生成。
        #
        # 清单从打包用的同一份 files / entries 列表生成，不另写一份路径列表：
        # 手写的那份迟早会和包的内容脱节，而脱节的形态是「清单说全过了、其实
        # 漏了那个新加的文件」，比没有清单更糟。
        #
        # 这挡的是传输损坏与不完整解包（解包到一半被打断会留下一个看起来正常、
        # 实际缺文件的目录），不是篡改：有权改包的人可以连 SHA256SUMS 一起改。
        sums = "".join("%s  %s\n" % (_sha256(ROOT / f), f) for f in files)
        sums += "".join("%s  %s\n" % (e["sha256"], e["file"]) for e in entries)
        sums += "".join("%s  %s\n" % (_sha256_text(text), name) for name, text in
                        (("MANIFEST.txt", manifest), ("install.sh", install_sh)))

        def add_bytes(tf, name, text, mode=0o644):
            data = text.encode("utf-8")
            info = tarfile.TarInfo(bundle_name + "/" + name)
            info.size = len(data)
            info.mode = mode
            info.mtime = int(os.path.getmtime(str(ROOT / "bin" / "lc")))
            tf.addfile(info, io.BytesIO(data))

        out.parent.mkdir(parents=True, exist_ok=True)
        with tarfile.open(str(out), "w:gz") as tf:
            for f in files:
                tf.add(str(ROOT / f), arcname=bundle_name + "/" + f)
            for _ref, fname in images:
                tf.add(str(tmpdir / fname), arcname=bundle_name + "/images/" + fname)
            add_bytes(tf, "MANIFEST.txt", manifest)
            add_bytes(tf, "SHA256SUMS", sums)
            add_bytes(tf, "install.sh", install_sh, mode=0o755)
    finally:
        shutil.rmtree(str(tmpdir), ignore_errors=True)

    # 纵深防御：包已经打完了，再独立核一遍敏感路径确实不在里面。
    # 只靠 .gitignore 正确是不够的——这个包要离开本机、跨网传递。
    with tarfile.open(str(out), "r:gz") as tf:
        packed = [m.name for m in tf.getmembers() if m.isfile()]
    leaked, rels = [], []
    for n in packed:
        rel = n.split("/", 1)[1] if "/" in n else n
        rels.append(rel)
        if rel in never or rel.startswith(BUNDLE_NEVER_DIRS):
            leaked.append(n)
    if leaked:
        out.unlink()
        die("包里出现了不该带走的文件，已删除产物：%s" % ", ".join(leaked))

    # 同一趟复核里再核一件事：SHA256SUMS 必须覆盖包内除它自己以外的每一个文件。
    # 这条是给以后往包里加东西的人兜底。漏了校验值的表现形态是内网侧 install.sh
    # 说「全部校验通过」而那个新文件根本没被核——假的安全感比没有清单更糟，
    # 而且要到出事时才发现。宁可在打包机上打不出包。
    unlisted = sorted(set(rels) - set(l.split("  ", 1)[1] for l in sums.splitlines()
                                      if l) - set(["SHA256SUMS"]))
    if unlisted:
        out.unlink()
        die("SHA256SUMS 没有覆盖包内这些文件，已删除产物：%s" % ", ".join(unlisted))

    ok("离线包已生成: %s (%.1f MB)" % (out, out.stat().st_size / 1048576.0))
    say("  %s内容: 源码 %d 个文件 + %d 个镜像 + MANIFEST.txt + install.sh%s"
        % (C["d"], len(files), len(entries), C["x"]))
    say("  %sSHA256SUMS 覆盖包内全部 %d 个文件（内网侧 install.sh 会核一遍）%s"
        % (C["d"], len(rels) - 1, C["x"]))
    if bundled_registry:
        say("  %s含 registry.json（结构定义，无凭证）：内网侧 lc init 只问地址与密钥%s"
            % (C["d"], C["x"]))
    else:
        say("  %s不含 registry.json：内网侧 lc init 要完整配置一遍%s"
            % (C["d"], C["x"]))
    say("  %s内网侧: tar xzf %s && cd %s && ./install.sh%s"
        % (C["d"], out.name, bundle_name, C["x"]))


def cmd_migrate(argv):
    """把 registry 里遗留的明文 header 值搬进 .env，registry 只留变量名。"""
    reg, env = load_registry(), read_env()
    moved = 0
    for name in sorted(reg["upstreams"]):
        u = reg["upstreams"][name]
        for hk in legacy_headers(u):
            var = env_header_name(name, hk)
            env[var] = u["headers"][hk]
            u["headers"][hk] = var
            say("  %s: HTTP 头 %s 的值 -> .env/%s" % (name, hk, var))
            moved += 1
    if not moved:
        ok("没有需要迁移的明文 header 值")
        return
    save_registry(reg)
    write_env(env)
    if reg["upstreams"]:
        sync(reg, quiet=True)
    ok("已迁移 %d 个 header 值，registry.json 里只剩变量名" % moved)
    warn("这些值之前是明文写在 registry.json 里的。如果它曾经被提交过，"
         "对应凭证应当视为已泄漏，请轮换。")


COMMANDS = [
    ("init", cmd_init, "交互式初始化（生成 master key、添加上游）"),
    ("add", cmd_add, "交互式添加一个上游"),
    ("ls", cmd_ls, "列出所有上游"),
    ("use", cmd_use, "切换默认上游: lc use <name>"),
    ("rm", cmd_rm, "删除上游: lc rm <name>"),
    ("up", cmd_up, "启动网关"),
    ("down", cmd_down, "停止网关"),
    ("status", cmd_status, "查看网关状态"),
    ("logs", cmd_logs, "跟踪网关日志"),
    ("test", cmd_test, "协议层 5 项测试: lc test [name...]"),
    ("e2e", cmd_e2e, "端到端测试（真改代码）: lc e2e [name...]"),
    ("code", cmd_code, "用当前上游启动 Codex: lc code [codex 参数]"),
    ("doctor", cmd_doctor, "环境体检（代理劫持 + 上游 tool calling 探测）"),
    ("sync", cmd_sync, "由 registry.json 重新生成配置"),
    ("migrate", cmd_migrate, "把 registry 里遗留的明文 header 值搬进 .env"),
    ("export", cmd_export,
     "打离线包: lc export [--out 路径] [--no-images] [--no-registry]"),
]


def usage():
    say("%sairgap-coder%s — 内网离线 AI 编码 CLI\n" % (C["B"], C["x"]))
    say("用法: lc <命令> [参数]\n")
    for n, _, d in COMMANDS:
        say("  %s%-8s%s %s" % (C["B"], n, C["x"], d))
    say("\n配置全部通过命令完成，不需要手改 yaml/toml。")
    # 环境变量在 help 里也要露一面，否则它就是个只有测试知道的暗门（issue #27）
    say("\n环境变量:")
    say("  %sLC_GATEWAY_WAIT%s  lc up 等网关就绪的秒数（默认 %d，慢机器调大）"
        % (C["B"], C["x"], GW_WAIT_DEFAULT))


def main():
    argv = sys.argv[1:]
    if argv and argv[0] in ("-V", "--version", "version"):
        say("airgap-coder %s" % project_version())
        return
    if not argv or argv[0] in ("-h", "--help", "help"):
        usage()
        return
    for n, fn, _ in COMMANDS:
        if argv[0] == n:
            return fn(argv[1:])
    die("未知命令 '%s'，看 `lc help`" % argv[0])


if __name__ == "__main__":
    main()
